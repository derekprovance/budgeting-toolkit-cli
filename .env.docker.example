# Container-only settings for docker-compose.yml (the dev stack).
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --wait
#
# .env.docker is gitignored. Put ONLY these values here: CLI secrets
# (FIREFLY_API_TOKEN, ANTHROPIC_API_KEY) belong in .env / .env.dev and must
# never be passed to a container. Every value is required; compose refuses to
# start with any of them empty.

POSTGRES_USER=firefly
# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=firefly

# Exactly 32 characters. Generate one: openssl rand -hex 16
FIREFLY_APP_KEY=
