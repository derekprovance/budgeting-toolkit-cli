{
    "name": "budgeting-toolkit-cli",
    "version": "9.0.0",
    "type": "module",
    "main": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js"
    },
    "scripts": {
        "start": "tsx src/index.ts",
        "start:dev": "ENV_FILE=.env.dev tsx src/index.ts",
        "compile": "rm -Rf ./dist && tsc",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
        "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "test:e2e": "bash scripts/e2e-test.sh",
        "test:e2e:docker": "ENV_FILE=.env.dev bash scripts/e2e-test.sh",
        "seed:docker": "ENV_FILE=.env.dev node --import tsx/esm scripts/seed-test-data.ts",
        "db:dump": "docker compose exec db pg_dump -U firefly --clean --if-exists --no-owner --no-acl firefly > docker/db-init/01-seed.sql",
        "linter": "eslint . && prettier . --write",
        "prepack": "npm run compile",
        "dev:install": "npm pack && npm install -g *.tgz && rm -f *.tgz"
    },
    "keywords": [],
    "author": "Derek Provance",
    "license": "MIT",
    "description": "Budgeting toolkit with AI-powered transaction categorization",
    "engines": {
        "node": "26.x"
    },
    "bin": {
        "btk": "./dist/index.js"
    },
    "files": [
        "dist",
        "config.yaml.example",
        ".env.example"
    ],
    "dependencies": {
        "@anthropic-ai/sdk": "^0.120.0",
        "@derekprovance/firefly-iii-sdk": "6.5.5",
        "@inquirer/prompts": "^8.6.0",
        "axios": "^1.19.0",
        "chalk": "^6.0.0",
        "commander": "^15.0.0",
        "dotenv": "^17.4.2",
        "js-yaml": "^5.3.0",
        "ora": "^9.4.1",
        "pino": "^10.3.1",
        "strip-ansi": "^7.2.0",
        "table": "^6.9.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^26.2.0",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.11.0",
        "jest": "^30.4.2",
        "jiti": "^2.7.0",
        "prettier": "^3.9.6",
        "ts-jest": "^29.4.12",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0"
    }
}
